    {"source_device_code": "KST-001", "device_number": "KST001"},
    {"source_device_code": "KST-002", "device_number": "KST002"}
  ],
  "clientId": "S&{deviceNumber}&{productId}&{userId}",
  "propertyTopic": "/{productId}/{deviceNumber}/property/post",
  "eventTopic": "/{productId}/{deviceNumber}/event/post",
  "encoding": "UTF-8",
  "qos": 1,
  "items": [
    {
      "kstPath": "/Status",
      "s1Type": "property",
      "identifier": "kst_status",
