      "identifier": "kst_exposure_result",
      "valueSource": "CRESULT",
      "recommendedDataType": "string"
    },
    {
      "kstPath": "/Heart",
      "legacyKstPath": "/HeartBeat",
      "s1Type": "property",
      "identifier": "kst_heartbeat",
      "valueSource": "HeartBeat",
      "recommendedDataType": "integer"
    },
    {
      "kstPath": "/Mode",
      "s1Type": "property",
      "identifier": "kst_mode",
      "valueSource": "Mode",
      "recommendedDataType": "string"
    }
  ],
  "payloadExample": [
